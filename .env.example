# Airflow Configuration
AIRFLOW_DB_PASSWORD=airflow
AIRFLOW_SECRET_KEY=your-secret-key-change-in-production

# MLflow Configuration
MLFLOW_DB_PASSWORD=mlflow

# Application Configuration
MLFLOW_TRACKING_URI=http://mlflow-server:5000
PYTHONUNBUFFERED=1

# FastAPI Serving
# Which registered MLflow model to serve. Tries Production first, falls back to Staging.
# Must be a full pipeline-qualified name from that pipeline's models.yaml — every
# pipeline's models.yaml `name:` values are prefixed with the pipeline_type to keep
# MLflow's shared registry namespace collision-free (e.g. "lightgbm_gbm" alone was
# ambiguous once more than one pipeline registered a model under that name).
# Options: biomedical_clinical_lightgbm_gbm, biomedical_clinical_ridge_l2,
#          hospital_readmission_lagged_lightgbm_gbm, hospital_readmission_lagged_elastic_net,
#          bioinfo_gene_lightgbm_gbm, ...
# The serving schema (required input features) is derived automatically at load time
# from the chosen model's own training run — see GET /schema once the server is up.
SERVING_MODEL_NAME=hospital_readmission_lagged_lightgbm_gbm
