# Airflow Configuration
AIRFLOW_DB_PASSWORD=airflow
AIRFLOW_SECRET_KEY=your-secret-key-change-in-production

# MLflow Configuration
MLFLOW_DB_PASSWORD=mlflow

# Application Configuration
MLFLOW_TRACKING_URI=http://mlflow-server:5000
PYTHONUNBUFFERED=1

# Required as of the SERVING_MODEL_NAME hardcoded-default removal from
# src/serve.py and docker-compose.yml — the server now refuses to start
# without this set. See .env.example for other valid model names.
SERVING_MODEL_NAME=hospital_readmission_lagged_lightgbm_gbm
